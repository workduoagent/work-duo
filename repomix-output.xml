/**
 * 本轮执行 DAG 画布（第二期 · 方案 C Graph-first 升级版）。
 *
 * 相对 Phase 3 §3.2 `ArtifactCanvas` 的关键升级（用户二期扩展点）：
 *  - **复合 DAG**：顶层是规划步骤节点（PlanStep，含 dependsOn 依赖连边）；
 *    每个步骤**内部实际执行的工具调用**也展开为该步骤下方的子节点（ToolStep），
 *    形成「步骤 → 工具」两级结构，不再只是 5 个步骤 = 5 个节点的简单轨迹图。
 *  - 数据全部来自 `useAgentSession` 的实时前端状态（`planSteps` / `toolSteps`），
 *    按 `toolSteps.step` 归组到对应 PlanStep，**无后端依赖**。
 *  - 节点状态色：pending/running/success/failed；当前 running 节点呼吸高亮。
 *  - 点选节点 → 底部详情条（步骤：标题/状态/摘要/产物；工具：名称/操作/路径/±行数/结果摘要）。
 *  - 保留：拖拽平移、滚轮缩放、分支右键菜单「从此步骤分支」（仅 plan 节点）、分支对比横幅。
 *  - 三态：COMPOSITE（完整 DAG）/ SIMPLE_CHAT（无 plan → 单点任务卡，工具一行流）/ 空（未运行）。
 *
 * 布局：plan 节点按 dependsOn 拓扑深度分行；同一深度节点并排成行；
 * 每个 plan 节点下方垂直堆叠其 tool 子节点（居中于 plan 节点 x），父子 + 链式连边。
 */
import { useCallback, useMemo, useRef, useState, type MouseEvent, type WheelEvent } from 'react'
import { GitBranch, X, FileText, Maximize, Loader2, CheckCircle2, XCircle, Wrench } from 'lucide-react'
import type {
  ArtifactRef,
  BranchStep,
  PlanBranchGenerated,
  PlanStep,
  ToolStep,
} from './types'

interface RunDagCanvasProps {
  planSteps: PlanStep[]
  toolSteps: ToolStep[]
  artifacts: ArtifactRef[]
  planBranch: PlanBranchGenerated | null
  /** 点击产物文件时触发（chat.tsx 调 read_artifact 命令预览）。 */
  onPreviewArtifact: (path: string) => void
  /** 右键「从此步骤分支」时触发（chat.tsx 调 branch_from_step 命令）。 */
  onBranchFromStep: (step: number) => void
  /** 应用分支（用新分支步骤替换原尾段）。 */
  onApplyBranch: () => void
  /** 放弃分支对比。 */
  onDismissBranch: () => void
}

