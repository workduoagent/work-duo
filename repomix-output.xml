      padding: 1px 5px;
      border-radius: 4px;
      background: var(--color-background-subtle);
      color: var(--color-foreground-intense);
      font-size: 12px;
    }
  }

  &__cron,
  &__cron-prompt {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  &__api {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;

    .squad-editor__hint {
      margin-top: 0;
