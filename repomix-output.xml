  }

  &__curl {
    margin: 0;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--color-background-subtle);
    border: 1px solid var(--color-border-muted);
    color: var(--color-foreground-intense);
    font-size: 12px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-all;
  }

  &__dag {
    margin-top: 8px;
    height: 320px;
    border: 1px solid var(--color-border-muted);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-background-subtle);
  }

  &__node {
    position: relative;
    min-width: 120px;
    padding: 8px 14px;
    border-radius: 10px;
    background: var(--color-background-base);
    border: 1px solid var(--color-brand-600);
    color: var(--color-foreground-intense);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);

    &-role {
      font-size: 13px;
