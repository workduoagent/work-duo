}

.mfm__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px 24px; /* 增加网格间距，减少拥挤感 */
}

.mfm__span-2 {
  grid-column: span 2;
}

/* 分类参数：紧凑 2 列，缩短纵向高度，尽量不触发滚动条 */
.mfm__param-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px 24px;
  align-items: start;

  /* 仅长文本（系统提示词等）独占整行，其余控件均按 2 列排布 */
