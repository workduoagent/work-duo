// 闭合第二处 .agent-chat 块（轨迹视图 / 产物画廊等样式归属其中）
}

@keyframes agent-trace-spin {
  to {
    transform: rotate(360deg);
  }
}

// ── §3.2 规划 DAG 画布（右栏「画布」Tab）──
.agent-canvas {
  width: 100%;
  height: 100%;
  // 整图由 SVG viewBox 等比缩放填满容器，禁止出现 XY 滚动条
  overflow: hidden;
  padding: 0;

  &__empty {
    padding: 24px 16px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--color-foreground-muted, #999);
  }

  &__svg {
    display: block;
    width: 100%;
    height: 100%;
    // 拖拽平移时禁止选中 SVG 内文字（避免「全选高亮」干扰）
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;

    &.is-dragging {
      cursor: grabbing;
    }
  }

  // ── 交互模式（ArtifactCanvas）──
  &--interactive {
    position: relative;
    cursor: grab;

    &:active {
      cursor: grabbing;
    }
  }

  // 工具栏（重置视图等）
  &__toolbar {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 10;
    display: flex;
    gap: 4px;

    button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border: 1px solid var(--color-border, #e5e5e5);
      border-radius: 6px;
      background: var(--color-background, #fff);
      color: var(--color-foreground-muted, #666);
      cursor: pointer;
      transition: all 0.15s ease;

      &:hover {
        border-color: var(--color-primary, #1677ff);
        color: var(--color-primary, #1677ff);
      }

      .dark & {
        background: #1f1f1f;
        border-color: #2f2f2f;
        color: #aaa;
      }
    }
  }

  // 分支对比横幅
  &__branch-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 15;
    padding: 8px 12px;
    background: var(--color-background-subtle, #f0f4ff);
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    font-size: 12px;

    .dark & {
      background: #1a1f2e;
      border-color: #2a2f3a;
    }
  }

  &__branch-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--color-foreground, #222);
    margin-bottom: 6px;
  }

  &__branch-goal {
    font-weight: 400;
    color: var(--color-foreground-muted, #999);
    margin-left: 4px;
  }

  &__branch-body {
    display: flex;
    gap: 12px;
  }

  &__branch-col {
    flex: 1;
    min-width: 0;
  }

  &__branch-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-foreground-muted, #999);
    margin-bottom: 4px;
  }

  &__branch-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 6px;
    border-radius: 4px;
    font-size: 11.5px;
    margin-bottom: 2px;

    &--old {
      color: var(--color-foreground-muted, #999);
      text-decoration: line-through;
      opacity: 0.7;
    }

    &--new {
      color: var(--color-primary, #1677ff);
      background: rgba(22, 119, 255, 0.06);
    }
  }

  &__branch-step {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    font-size: 10px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-border, #d0d5dd);
    color: #fff;
  }

  &__branch-actions {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  &__branch-btn {
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;

    &--apply {
      background: var(--color-primary, #1677ff);
      color: #fff;
      border-color: var(--color-primary, #1677ff);

      &:hover {
        opacity: 0.85;
      }
    }

    &--dismiss {
      background: transparent;
      color: var(--color-foreground-muted, #666);
      border-color: var(--color-border, #e5e5e5);

      &:hover {
        color: var(--color-foreground, #222);
      }
    }
  }

  // 右键菜单
  &__context-menu {
    position: absolute;
    z-index: 20;
    min-width: 180px;
    padding: 4px;
    background: var(--color-background, #fff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);

    .dark & {
      background: #1f1f1f;
      border-color: #2f2f2f;
    }

    button {
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      padding: 6px 10px;
      border: none;
      background: transparent;
      font-size: 12px;
      color: var(--color-foreground, #222);
      border-radius: 6px;
      cursor: pointer;
      text-align: left;

      &:hover {
        background: var(--color-background-subtle, #f0f4ff);
        color: var(--color-primary, #1677ff);
      }

      .dark &:hover {
        background: #2a2f3a;
      }
    }
  }

  // 选中节点的产物侧边面板
  &__artifact-panel {
    position: absolute;
    bottom: 6px;
    left: 6px;
    right: 6px;
    max-height: 200px;
    overflow-y: auto;
    z-index: 12;
    padding: 8px 10px;
    background: var(--color-background, #fff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 8px;
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);

    .dark & {
      background: #1f1f1f;
      border-color: #2f2f2f;
    }
  }

  &__artifact-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-foreground, #222);
    margin-bottom: 6px;

    button {
      margin-left: auto;
      border: none;
      background: transparent;
      cursor: pointer;
      color: var(--color-foreground-muted, #999);
      padding: 2px;
      display: inline-flex;

      &:hover {
        color: var(--color-foreground, #222);
      }
    }
  }

  &__artifact-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  &__artifact-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
    text-align: left;
    width: 100%;

    &:hover {
      background: var(--color-background-subtle, #f0f4ff);
      border-color: var(--color-border, #e5e5e5);
    }

    .dark &:hover {
      background: #2a2f3a;
    }
  }

  &__artifact-icon {
    flex: 0 0 auto;
    color: var(--color-primary, #1677ff);
  }

  &__artifact-info {
    flex: 1;
    min-width: 0;
  }

  &__artifact-name {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-foreground, #222);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  &__artifact-path {
    font-size: 10.5px;
    color: var(--color-foreground-muted, #999);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}

// ── 产物预览 Modal 样式（chat.tsx 的 artifactPreview Modal）──
.agent-chat__artifact-loading {
  padding: 40px;
  text-align: center;
  color: var(--color-foreground-muted, #999);
  font-size: 13px;
}

.agent-chat__artifact-preview {
  max-height: 70vh;
  overflow-y: auto;
}

.agent-chat__artifact-img {
  max-width: 100%;
  max-height: 60vh;
  object-fit: contain;
  border-radius: 8px;
}

.agent-chat__artifact-text {
  max-height: 55vh;
  overflow: auto;
  padding: 12px;
  background: var(--color-background-subtle, #f6f8fa);
  border-radius: 8px;
  font-size: 12.5px;
  line-height: 1.6;
  font-family: var(--font-mono, 'Cascadia Code', 'Fira Code', 'Consolas', monospace);
  white-space: pre-wrap;
  word-break: break-all;
  margin: 0;

  .dark & {
    background: #161616;
    color: #d4d4d4;
  }
}

.agent-chat__artifact-truncated {
  margin-top: 8px;
  padding: 6px 12px;
  font-size: 11px;
  color: var(--color-warning, #d97706);
  background: rgba(217, 119, 6, 0.08);
  border-radius: 6px;
}

.agent-chat__artifact-dir {
  &-head {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-foreground-muted, #666);
    margin-bottom: 8px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 40vh;
    overflow-y: auto;

    li {
      padding: 4px 8px;
      font-size: 12.5px;
      color: var(--color-foreground, #222);
      border-radius: 4px;

      &:hover {
        background: var(--color-background-subtle, #f0f4ff);
      }

      .dark &:hover {
        background: #2a2f3a;
      }
    }
  }
}

.agent-chat__artifact-msg {
  padding: 20px 16px;
  font-size: 13px;
  color: var(--color-foreground-muted, #666);
  line-height: 1.6;
}

.agent-chat__artifact-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--color-border, #e5e5e5);
  font-size: 11px;
  color: var(--color-foreground-muted, #999);

  .dark & {
    border-color: #2f2f2f;
  }
}

// ── 任务错误诊断面板（agent-task-error 渲染进气泡，原 <pre> 无样式会撑爆高度）──
.agent-chat__error-panel {
  margin: 8px 0;
  border: 1px solid var(--color-error, #ef4444);
  border-radius: 8px;
  background: rgba(239, 68, 68, 0.06);
  overflow: hidden;
}

.agent-chat__error-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--color-error, #ef4444);
}

.agent-chat__error-title {
  flex: 0 0 auto;
}

.agent-chat__error-time {
  margin-left: auto;
  font-weight: 400;
  font-size: 11px;
  color: var(--color-foreground-muted, #999);
}

.agent-chat__error-body {
  max-height: 320px;
  overflow: auto;
  margin: 0;
  padding: 10px 12px;
  font-family: var(--font-mono, ui-monospace, 'Cascadia Code', monospace);
  font-size: 12px;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
  background: var(--color-background, #fff);
  color: var(--color-foreground, #222);

  .dark & {
    background: #161616;
    color: #d4d4d4;
  }
}

.agent-chat__error-actions {
  display: flex;
  gap: 8px;
  padding: 8px 12px;
}

// ── 全局 Modal 高度安全网：内容过长时内部滚动，绝不顶出视口（修复报错弹窗「拉上天」）──
.agent-chat {
  .ant-modal-content {
    max-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
  }

  .ant-modal-header,
  .ant-modal-footer {
    flex: 0 0 auto;
  }

  .ant-modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
  }
}

