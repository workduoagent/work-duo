  &__mcp-card-ico {
    color: var(--color-brand-600);
    flex: none;
  }

  &__mcp-card-name {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  &__mcp-card-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-foreground-intense);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  &__mcp-card-sub {
    font-size: 11px;
    color: var(--color-foreground-muted);
    margin-top: 1px;
  }

  &__mcp-card-tools {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px dashed var(--color-border-muted);
    padding-top: 8px;
    /* 工具较多时限定卡片高度，超出滚动，避免单卡被无限拉高 */
    max-height: 220px;
    overflow-y: auto;
    padding-right: 4px;

    &::-webkit-scrollbar {
      width: 6px;
    }

    &::-webkit-scrollbar-thumb {
      background: var(--color-border);
      border-radius: 999px;
    }
  }

  &__mcp-card-hint {
    font-size: 12px;
    color: var(--color-foreground-muted);
    line-height: 1.5;
  }

  &__tool-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 5px 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease;

    &:hover {
      background: var(--color-background-base);
    }
  }

  &__tool-name {
    font-size: 13px;
    color: var(--color-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  &__curl {
    margin: 0;
    padding: 10px 12px;
    border-radius: 6px;
    background: var(--color-background-base);
    border: 1px solid var(--color-border-muted);
    color: var(--color-foreground-intense);
    font-size: 13px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-all;
  }
}



/* ---------------- 运行控制台 ---------------- */
.squad-console {
  display: flex;
  flex-direction: column;
  gap: 12px;

  &__input {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  &__board {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 12px;
    min-height: 240px;
    max-height: 56vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--color-background-muted);
  }

  &__empty {
    margin: auto;
    font-size: 13px;
    color: var(--color-foreground-muted);
  }
}

.squad-round {
  border: 1px solid var(--color-border-muted);
  border-radius: 8px;
  padding: 10px 12px;
  background: var(--color-background);

  &__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  &__role {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-foreground-intense);
  }

  &__content {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-foreground);
    white-space: pre-wrap;
    word-break: break-word;
  }

  &--summary {
    border-color: var(--color-brand-600);
  }

  &--final {
    background: var(--color-background-subtle);
  }
}

/* 团队记忆面板 */
.squad-mem {
  display: flex;
  flex-direction: column;
  gap: 16px;

  &__add {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-background-subtle);
  }

  &__add-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  &__cat {
    min-width: 116px;
  }

  &__agent {
    min-width: 160px;
  }

  &__pipeline-preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 4px;
  }

  &__pipeline-node {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--color-border);
