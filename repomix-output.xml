import { createSlice, type PayloadAction } from '@reduxjs/toolkit'

export type ThemeMode = 'light' | 'dark' | 'system'

/** 主品牌色调；仅影响 --color-brand-* 主品牌色，语义色 success/danger 不变。
 *  - sky / mint / lilac：对应新 Logo「深海蓝绿 Ocean」三色环；
