  }

  &__plan,
  &__tools {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  &__plan-item,
  &__tool {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  &__plan-title {
    font-weight: 500;
  }

  &__plan-sum {
    color: var(--color-foreground-muted, #999);
