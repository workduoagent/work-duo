<file path="src/styles/root.scss">
/* ============================================================
 * root.scss — 全局样式入口（单一入口）
 * 引入顺序：variables(令牌) → mixins(复用类) → layout(布局)
 * 基础重置 + 亮/暗基础 + 滚动条 + Markdown 排版。
 * 使用现代 @use 模块系统（@import 在 Dart Sass 3.0 将被移除）。
 * ============================================================ */

@use "./variables.scss";
@use "./fonts.scss";
@use "./mixins.scss";
@use "./layout.scss";
@use "./message.scss";

/* 全局基础 */
html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  background-color: var(--color-background);
  color: var(--color-foreground);
  font-family: var(--font-sans);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  -webkit-text-size-adjust: 100%;
}

/* 滚动条：细、默认隐藏，悬浮或滚动时出现，失焦隐藏 */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
  background: transparent;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background-color: transparent;
  transition: background-color 0.2s ease;
}

/* 鼠标悬浮滚动容器，或正在滚动（.wd-scrolling）时显示 */
*:hover::-webkit-scrollbar-thumb,
.wd-scrolling::-webkit-scrollbar-thumb {
  background-color: color-mix(in srgb, var(--color-foreground) 22%, transparent);
}

*:hover::-webkit-scrollbar-thumb:hover,
.wd-scrolling::-webkit-scrollbar-thumb:hover {
  background-color: color-mix(in srgb, var(--color-foreground) 32%, transparent);
}

/* Firefox 兜底：细滚动条（Firefox 不支持滚动时自动隐藏，退化为常显细条） */
* {
  scrollbar-width: thin;
  scrollbar-color: color-mix(in srgb, var(--color-foreground) 22%, transparent) transparent;
}

/* 暗色下 antd 等第三方可能会注入 body 默认色，这里兜底确保整页底色跟随主题 */
#root {
  background-color: var(--color-background);
  color: var(--color-foreground);
}

/* ============================================================
 * Markdown 渲染（.md-body），由 MarkdownRenderer 使用
 * 排版目标：正文字号略放大、代码必须"看得清"（高对比 + 明确的底与边框）。
 * ============================================================ */
.md-body {
  font-size: 0.9375rem; /* 15px：Markdown 正文比 UI 默认 14px 略大，长文更耐读 */
  line-height: 1.8;
  color: var(--color-foreground);
  word-break: break-word;
}

.md-body > *:first-child {
  margin-top: 0;
}

.md-body > *:last-child {
  margin-bottom: 0;
}

.md-body h1 {
  margin: 1.5rem 0 0.75rem;
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 1.4;
}

.md-body h2 {
  margin: 1.5rem 0 0.625rem;
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.45;
}

.md-body h3 {
  margin: 1.25rem 0 0.5rem;
  font-size: 1.125rem;
  font-weight: 600;
  line-height: 1.5;
}

.md-body h4,
.md-body h5,
.md-body h6 {
  margin: 1rem 0 0.5rem;
  font-size: 1rem;
  font-weight: 600;
}

.md-body p {
  margin-bottom: 0.75rem;
}

.md-body strong {
  font-weight: 600;
  color: var(--color-foreground-intense);
}

.md-body ul,
.md-body ol {
  margin-bottom: 0.75rem;
  padding-left: 1.5rem;
}

.md-body ul {
  list-style: disc;
}

.md-body ol {
  list-style: decimal;
}

.md-body li {
  margin: 0.25rem 0;
}

.md-body li > ul,
.md-body li > ol {
  margin-bottom: 0;
}

/* GFM 任务列表：去掉项目符号 */
.md-body li.task-list-item {
  list-style: none;
  margin-left: -1.25rem;
}

.md-body a {
  color: var(--color-brand-600);
  text-underline-offset: 2px;
}

.md-body a:hover {
  text-decoration: underline;
}

.md-body hr {
  height: 1px;
  margin: 1.5rem 0;
  border: none;
  background: var(--color-border);
}

/* ---------- 行内代码：核心修复点 ----------
 * 原样式只有极浅灰底、无边框、无显式字号/字体/颜色，观感"糊成一团"。
 * 现改为：明确的底 + 细边框 + 深色高对比字 + 等宽字体 + 略放大字号。
 */
.md-body code {
  padding: 0.15em 0.4em;
  border: 1px solid var(--color-code-border);
  border-radius: 6px;
  background: var(--color-code-bg);
  color: var(--color-code-fg);
  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
  font-size: 0.875em;
  font-weight: 500;
  font-variant-ligatures: none;
  white-space: break-spaces;
}

/* ---------- 围栏代码块 ---------- */
.md-body pre {
  margin-bottom: 0.875rem;
  padding: 0.875rem 1rem;
  border: 1px solid var(--color-code-border);
  border-radius: 10px;
  background: var(--color-code-bg);
  color: var(--color-foreground);
  font-size: 0.8125rem; /* 13px */
  line-height: 1.7;
  overflow-x: auto;
}

/* 代码块内的 code 复用同一等宽字体，但要去掉行内样式（底/边框/内边距） */
.md-body pre code {
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  font-weight: 400;
  white-space: pre;
}

/* ---------- highlight.js 语法高亮（自建主题，跟随 .light/.dark 令牌） ----------
 * 替代原先强引入的 highlight.js/styles/github.css（亮色硬编码白底，暗色下整块刷白、token 色崩坏）。
 * 这里只定义语法 token 颜色，背景统一交给 .md-body pre；颜色全部走 variables.scss 的 --hljs-* 令牌。
 */
.md-body .hljs {
  color: var(--hljs-fg);
  background: transparent;
}

.md-body .hljs-comment,
.md-body .hljs-quote {
  color: var(--hljs-comment);
  font-style: italic;
}

.md-body .hljs-keyword,
.md-body .hljs-selector-tag,
.md-body .hljs-literal,
.md-body .hljs-doctag {
  color: var(--hljs-keyword);
}

.md-body .hljs-string,
.md-body .hljs-regexp {
  color: var(--hljs-string);
}

.md-body .hljs-number,
.md-body .hljs-meta .hljs-number {
  color: var(--hljs-number);
}

.md-body .hljs-title,
.md-body .hljs-title.class_,
.md-body .hljs-title.function_,
.md-body .hljs-section {
