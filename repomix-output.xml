    font-size: 12px;
    color: var(--color-foreground-muted);
  }

  &__board {
    max-height: 480px;
    overflow-y: auto;
  }

  &__hint {
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-foreground-muted);

