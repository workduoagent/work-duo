/** 创建一个带默认参数的新模型草稿（用于"新增"） */
export function createEmptyModel(category: string): ModelConfig {
  const now = new Date().toISOString()
  const base: ModelConfig = {
    id: crypto.randomUUID(),
    name: '',
    category,
    provider: 'openai',
    baseUrl: '',
