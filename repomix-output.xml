/* ============================================================
 * variables.scss — 项目级设计令牌（Design Tokens）
 * ------------------------------------------------------------
 * 基于新 Logo 的「深海蓝绿（Ocean）」三色环调色盘：
 *   - 天青蓝 Sky   #38BDF8 → #60CFFA：主品牌色（按钮、选中、焦点）
 *   - 薄荷绿 Mint  #34D399 → #5CDFB5：成功 / 运行中 / 知识库连接态
 *   - 淡紫 Lilac  #A78BFA → #C4A8FE：强调 / 点缀
 *   - 深海背景：#071018（底）/ #0B1A2E（elevated / 升层）
 *   - 中性色：#E8F6FC（主文字）/ #9EC9DB（次文字）
 *   - 边框：rgba(56, 189, 248, 0.25)
 * ------------------------------------------------------------
 * 亮色挂在 :root / .light，暗色挂在 .dark。
 * 语义映射：
 *   --color-brand-*  → Sky 品牌色（随色调可切换为 Mint / Lilac）
 *   --color-success-*→ Mint 成功/运行态
 *   --color-danger-* → 柔和红 危险/强调态
 * ============================================================ */

:root,
.light {
  /* 表面 / 文本（浅色调：淡海蓝，避免纯白死白） */
  --color-background: #f0f8fc;
  --color-background-subtle: #e8f4fa; /* 卡片/浮层 */
  --color-background-muted: #dceff7; /* hover/压条 */

  --color-foreground: #0b2030; /* 深海军：柔和正文 */
  --color-foreground-muted: #4a6b7c; /* 淡海蓝灰：次级文字 */
  --color-foreground-intense: #07202f; /* 标题 */
  --color-foreground-inverse: #f0f8fc;

  /* 边框 - 淡海蓝，与背景融洽 */
  --color-border: #cfe6f0;
  --color-border-muted: #e8f4fa;

  /* 代码（行内 code / 围栏代码块） */
  --color-code-bg: #eaf6fc;
  --color-code-border: #cfe6f0;
  --color-code-fg: #0b4a63; /* 深青墨 */

  /* highlight.js 语法高亮令牌（亮色版） */
  --hljs-fg: #0b2030;
  --hljs-comment: #4a6b7c;
  --hljs-keyword: #0ea5e9; /* Sky 600 */
  --hljs-string: #059669; /* Mint 600 */
  --hljs-number: #38bdf8; /* Sky 500 */
  --hljs-title: #7c3aed; /* Lilac 600 */
  --hljs-attr: #059669;
  --hljs-built_in: #0ea5e9;
  --hljs-tag: #059669;
  --hljs-meta: #4a6b7c;
  --hljs-addition-fg: #059669;
  --hljs-addition-bg: #ecfdf5;
  --hljs-deletion-fg: #f87171;
  --hljs-deletion-bg: #fef2f2;

  /* 品牌色 - Sky（Logo 主色 / 默认色调） */
  --color-brand-50: #eaf8fe;
  --color-brand-100: #cfeffb;
  --color-brand-200: #a2e2f8;
  --color-brand-300: #6fd2f3;
  --color-brand-400: #4ccbf8;
  --color-brand-500: #38bdf8; /* Logo Sky 起点 / 核心交互色 */
  --color-brand-600: #0ea5e9; /* 浅色模式主按钮（更深的 Sky 600 保证对比度） */
  --color-brand-700: #0284c7;
  --color-brand-800: #0369a1;
  --color-brand-900: #075985;

  /* 危险色 - 柔和红（Logo 无红色，取通用危险语义色） */
  --color-danger: #f87171;
  --color-danger-bg: rgba(248, 113, 113, 0.10);
  --color-danger-50: #fef2f2;

  /* 成功色 - Mint（Logo 第二环，用于成功/运行中/连接态） */
  --color-success: #34d399; /* Logo Mint 起点 */
  --color-success-50: #ecfdf5;
  --color-success-bg: rgba(52, 211, 153, 0.10);

  /* 警告色 - 保留暖琥珀，不与 Mint 混淆 */
  --color-warning: #d97706;
  --color-warning-50: #fef3c7;

  /* 品牌渐变（强调按钮底：Sky → Mint） */
  --color-brand-gradient: linear-gradient(135deg, #38bdf8, #34d399);

  /* 阴影 - 深海军低透明度，柔和扩散 */
  --shadow-sm: 0 2px 12px rgba(7, 30, 48, 0.06);
  --shadow-md: 0 8px 32px rgba(7, 30, 48, 0.08);
  --shadow-pop: 0 16px 48px rgba(7, 30, 48, 0.12);
}

.dark {
  /* 深海背景（Logo 主背景） */
  --color-background: #071018;
  --color-background-subtle: #0b1a2e; /* elevated 卡片/浮层（略亮） */
  --color-background-muted: #0e2238; /* hover/压条 */

  --color-foreground: #e8f6fc; /* Logo 主文字 */
  --color-foreground-muted: #9ec9db; /* Logo 次文字 */
  --color-foreground-intense: #ffffff;
  --color-foreground-inverse: #071018;

  --color-border: rgba(56, 189, 248, 0.25); /* Logo 分割线 */
  --color-border-muted: rgba(56, 189, 248, 0.15);

  /* 代码（暗色）：深海底 + 亮青字 */
  --color-code-bg: #0b1a2e;
  --color-code-border: rgba(56, 189, 248, 0.20);
  --color-code-fg: #cfeaf5;

  /* highlight.js 语法高亮令牌（暗色版） */
  --hljs-fg: #e8f6fc;
  --hljs-comment: #9ec9db;
  --hljs-keyword: #7fd9fb; /* Sky bright */
  --hljs-string: #5cdfb5; /* Mint bright */
  --hljs-number: #38bdf8; /* Sky 500 */
  --hljs-title: #c4a8fe; /* Lilac bright */
  --hljs-attr: #5cdfb5;
  --hljs-built_in: #7fd9fb;
