  &__pipeline-idx {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-brand-600);
    color: var(--color-background);
    font-style: normal;
    font-size: 11px;
  }

  &__pipeline-arrow {
    font-style: normal;
    margin-left: 4px;
    color: var(--color-foreground-muted);
  }

  &__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 360px;
    overflow-y: auto;
  }

  &__item {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 10px 12px;
    background: var(--color-background);
  }

  &__item-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  &__key {
    font-weight: 600;
    color: var(--color-foreground-intense);
  }

  &__ref {
    margin-left: auto;
    font-size: 12px;
    color: var(--color-foreground-muted);
