.sandbox-node__meta-label {
  color: var(--color-foreground-muted);
}

.sandbox-node__meta-item b {
  color: var(--color-foreground-intense);
  font-weight: 600;
}

/* ---- 下：图标按钮组 ---- */
.sandbox-node__card-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  padding-top: 12px;
