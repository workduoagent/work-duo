/** 把 Tauri 抛出的错误统一为可读字符串。 */
function fmtErr(e: unknown): string {
  if (typeof e === 'string') return e
  if (e && typeof e === 'object' && 'message' in e) return String((e as { message: unknown }).message)
  return String(e)
}

