/* ------------------------------------------------------------------ *
 * 工具（mcp_tool_definition）CRUD
 * ------------------------------------------------------------------ */

/** 按 mcp_id 列出工具。 */
export async function listMcpTools(mcpId: string): Promise<McpToolDefinition[]> {
