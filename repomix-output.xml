    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}

.sandbox-node__badge {
  flex: 0 0 auto;
  padding: 1px 8px;
  border-radius: 999px;
  font-size: 11px;
  line-height: 18px;
  font-weight: 500;
  color: var(--color-brand-600);
  background-color: var(--color-brand-50, var(--color-background-muted));
  border: 1px solid var(--color-border);
}

.sandbox-node__status {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 2px 9px;
  border-radius: 999px;
  font-size: 11px;
  line-height: 18px;
  background-color: var(--color-background-muted);
  color: var(--color-foreground-muted);
}

.sandbox-node__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex: 0 0 auto;
  background-color: currentColor;
}

.sandbox-node__status.is-ready {
  background-color: var(--color-success-50, var(--color-background-muted));
  color: var(--color-success);
}

.sandbox-node__status.is-ready .sandbox-node__dot {
  box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 35%, transparent);
