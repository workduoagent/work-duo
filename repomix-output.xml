.mfm__hint {
  font-weight: 400;
  color: var(--color-foreground-muted, #888);
  font-size: 0.75rem;
  margin-left: 6px;
}

/* Tool / Function Calling 开关行 */
.mfm__inline-icon {
  vertical-align: text-bottom;
  margin-right: 6px;
  color: var(--color-foreground-muted, #888);
}

.mfm__toolcalls {
