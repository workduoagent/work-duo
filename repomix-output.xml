/* 模型接入 / 编辑弹窗内的表单布局 - 简约重构版 */
.mfm {
  display: flex;
  flex-direction: column;
  gap: 24px; /* 段落间距，兼顾呼吸感与整体高度 */

  /* 给右侧滚动条和底部留出安全距离 */
  padding-right: 16px;
  padding-bottom: 8px;
}

.mfm__section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mfm__section-title {
  margin: 0;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-border, #eaeaea); /* 确保线条颜色足够浅 */
  font-size: 0.875rem; /* 稍微放大标题以区分层级 */
  font-weight: 500; /* 降低字重，避免过于突兀 */
  color: var(--color-foreground, #333);
