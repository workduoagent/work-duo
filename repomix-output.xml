    font-weight: 600;
  }

  &__thinking {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  &__think {
    border-left: 3px solid var(--color-info, #6366f1);
    padding: 4px 8px;
    background: var(--color-background-muted, #f7f8fa);
    border-radius: 0 6px 6px 0;

    .dark & {
      background: #202020;
    }
