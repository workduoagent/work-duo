  &__detail-preview {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    padding: 3px 10px;
    border: 1px solid var(--color-primary, #1677ff);
    border-radius: 6px;
    background: transparent;
    color: var(--color-primary, #1677ff);
    cursor: pointer;
    font-size: 11px;
    align-self: flex-start;
  }

  // 右键菜单
  &__context-menu {
    position: absolute;
    z-index: 30;
    background: var(--color-background, #fff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 8px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
    padding: 4px;
    min-width: 180px;

    button {
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      padding: 6px 8px;
      border: none;
      background: transparent;
      border-radius: 5px;
      cursor: pointer;
      font-size: 12px;
      color: var(--color-foreground, #222);
      text-align: left;

      &:hover {
        background: var(--color-background-subtle, #f0f4ff);
      }

      .dark & {
        color: #e6e6e6;

        &:hover {
          background: #2a2f3a;
        }
      }
    }
  }
}

@keyframes agent-dag-breath {
