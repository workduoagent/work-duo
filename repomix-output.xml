function toolDisplay(t: ToolStep): string {
  if (TOOL_DISPLAY[t.toolName]) return TOOL_DISPLAY[t.toolName]
  if (TOOL_DISPLAY[t.toolLabel]) return TOOL_DISPLAY[t.toolLabel]
  if (t.toolName.startsWith('mcp__')) {
    const parts = t.toolName.split('__')
    const svc = parts[1] ?? ''
    const tool = parts[2] ?? t.toolLabel
    return `${svc}·${tool}`
  }
  return t.toolLabel
}

function truncate(s: string, n: number): string {
  return s.length > n ? s.slice(0, n) + '…' : s
}

// ── 布局计算（复合 DAG） ──
interface PlanLayoutNode {
  step: number
  x: number
  y: number
  node: PlanStep
  subCount: number
}
interface ToolLayoutNode {
  step: number
  index: number
  x: number
  y: number
  tool: ToolStep
}
interface LayoutEdge {
  sx: number
  sy: number
  tx: number
  ty: number
  kind: 'dep' | 'parent' | 'chain'
}
interface Layout {
  planNodes: PlanLayoutNode[]
  toolNodes: ToolLayoutNode[]
  edges: LayoutEdge[]
  width: number
  height: number
}

function computeLayout(planSteps: PlanStep[], toolSteps: ToolStep[]): Layout {
  const taskIdMap = new Map<string, number>()
  planSteps.forEach((s) => {
    if (s.taskId) taskIdMap.set(s.taskId, s.step)
  })

  // 工具按步骤归组（保持事件到达顺序，体现真实执行序列）
  const toolsByStep = new Map<number, ToolStep[]>()
  toolSteps.forEach((t) => {
    if (typeof t.step !== 'number') return
    const arr = toolsByStep.get(t.step) ?? []
    arr.push(t)
    toolsByStep.set(t.step, arr)
  })

  const depthOf = (step: number, guard: number): number => {
    if (guard > 32) return 0
    const s = planSteps.find((x) => x.step === step)
    const deps = (s?.dependsOn ?? [])
      .map((d) => taskIdMap.get(d))
      .filter((x): x is number => x !== undefined)
    if (deps.length === 0) return 0
    return 1 + Math.max(...deps.map((d) => depthOf(d, guard + 1)))
  }

  const withDepth = planSteps.map((s) => ({ s, depth: depthOf(s.step, 0) }))
  const rows = new Map<number, typeof withDepth>()
  withDepth.forEach((d) => {
    const arr = rows.get(d.depth) ?? []
    arr.push(d)
    rows.set(d.depth, arr)
  })

  // 每行的「泳道高度」= 该行最高 plan 节点（含其工具子节点）的高度
  const subLaneHeight = (subCount: number) =>
    subCount > 0 ? SUB_GAP + subCount * SUB_H + (subCount - 1) * SUB_GAP : 0
  let maxDepth = 0
  let maxCols = 0
  rows.forEach((arr, depth) => {
    maxDepth = Math.max(maxDepth, depth)
    maxCols = Math.max(maxCols, arr.length)
  })
  const laneHeightOf = (depth: number) =>
    Math.max(
      ...(rows.get(depth) ?? []).map((d) => NODE_H + subLaneHeight(toolsByStep.get(d.s.step)?.length ?? 0)),
      NODE_H,
    )

  // 行 y 累计（上一行泳道高 + 行间距）
  const rowTopY: number[] = []
  for (let d = 0; d <= maxDepth; d++) {
    rowTopY[d] = d === 0 ? PAD : rowTopY[d - 1] + laneHeightOf(d - 1) + ROW_GAP
  }

  const planNodes: PlanLayoutNode[] = []
  const toolNodes: ToolLayoutNode[] = []
  const stepToPos = new Map<number, { x: number; y: number }>()
  withDepth.forEach(({ s, depth }) => {
    const row = rows.get(depth)!
    const colIndex = row.findIndex((c) => c.s.step === s.step)
    const x = PAD + colIndex * (NODE_W + COL_GAP)
    const y = rowTopY[depth]
    stepToPos.set(s.step, { x, y })
    const subs = toolsByStep.get(s.step) ?? []
    planNodes.push({ step: s.step, x, y, node: s, subCount: subs.length })
    subs.forEach((tool, i) => {
      toolNodes.push({
        step: s.step,
        index: i,
        x: x + (NODE_W - SUB_W) / 2,
        y: y + NODE_H + SUB_GAP + i * (SUB_H + SUB_GAP),
        tool,
      })
    })
  })

  const edges: LayoutEdge[] = []
  // ① plan 间依赖边
  withDepth.forEach(({ s }) => {
    const from = stepToPos.get(s.step)
    if (!from) return
    ;(s.dependsOn ?? []).forEach((d) => {
      const depStep = taskIdMap.get(d)
      if (depStep === undefined) return
      const to = stepToPos.get(depStep)
      if (!to) return
      edges.push({
        sx: to.x + NODE_W / 2,
        sy: to.y + NODE_H,
        tx: from.x + NODE_W / 2,
        ty: from.y,
        kind: 'dep',
      })
    })
  })
  // ② 父子边（plan → 首个工具子节点）+ ③ 链边（工具子节点链式）
  withDepth.forEach(({ s }) => {
    const subs = toolsByStep.get(s.step) ?? []
    if (subs.length === 0) return
    const plan = stepToPos.get(s.step)!
    subs.forEach((_tool, i) => {
      const cx = plan.x + (NODE_W - SUB_W) / 2
      if (i === 0) {
        edges.push({
          sx: plan.x + NODE_W / 2,
          sy: plan.y + NODE_H,
          tx: cx + SUB_W / 2,
          ty: plan.y + NODE_H + SUB_GAP,
          kind: 'parent',
        })
      } else {
        const prevY = plan.y + NODE_H + SUB_GAP + (i - 1) * (SUB_H + SUB_GAP)
        const curY = plan.y + NODE_H + SUB_GAP + i * (SUB_H + SUB_GAP)
        edges.push({
          sx: cx + SUB_W / 2,
          sy: prevY + SUB_H,
          tx: cx + SUB_W / 2,
          ty: curY,
          kind: 'chain',
        })
      }
    })
  })

  const width = Math.max(PAD * 2 + maxCols * NODE_W + Math.max(0, maxCols - 1) * COL_GAP, 260)
  const height = Math.max(rowTopY[maxDepth] + laneHeightOf(maxDepth) + PAD, 180)
  return { planNodes, toolNodes, edges, width, height }
}

// ── viewBox 状态 ──
interface ViewBox {
  x: number
  y: number
  w: number
  h: number
}

type SelectedNode =
  | { kind: 'plan'; step: number }
  | { kind: 'tool'; callId: string }
  | null

export function RunDagCanvas({
  planSteps,
  toolSteps,
  artifacts,
  planBranch,
  onPreviewArtifact,
  onBranchFromStep,
  onApplyBranch,
  onDismissBranch,
}: RunDagCanvasProps) {
  const isComposite = planSteps.length > 0
  const hasAny = planSteps.length > 0 || toolSteps.length > 0

  // SIMPLE_CHAT 单点任务卡：把全部工具按到达顺序作为一条纵向流
  const simpleTools = useMemo(() => toolSteps, [toolSteps])

  const layout = useMemo(
    () => (isComposite ? computeLayout(planSteps, toolSteps) : null),
    [isComposite, planSteps, toolSteps],
  )
  const artifactsByStep = useMemo(() => {
    const m = new Map<number, ArtifactRef[]>()
    artifacts.forEach((a) => {
      const arr = m.get(a.step) ?? []
      arr.push(a)
      m.set(a.step, arr)
    })
    return m
  }, [artifacts])

  const containerRef = useRef<HTMLDivElement>(null)
  const [viewBox, setViewBox] = useState<ViewBox>({ x: 0, y: 0, w: 600, h: 320 })
  const [selected, setSelected] = useState<SelectedNode>(null)
  const [contextMenu, setContextMenu] = useState<{ x: number; y: number; step: number } | null>(null)

  const dragRef = useRef<{ startX: number; startY: number; vbX: number; vbY: number; w: number; h: number } | null>(null)
  const [isDragging, setIsDragging] = useState(false)

  // layout 变化时重置 viewBox（按内容尺寸初始化，等比缩放填满）
  const baseW = layout ? layout.width : Math.max(260, simpleTools.length * (SUB_W + 12))
  const baseH = layout ? layout.height : Math.max(180, simpleTools.length * (SUB_H + 12))
  const layoutKey = `${baseW}x${baseH}`
  const lastLayoutKey = useRef(layoutKey)
  if (lastLayoutKey.current !== layoutKey) {
    lastLayoutKey.current = layoutKey
    setViewBox({ x: 0, y: 0, w: baseW, h: baseH })
  }

  const onSvgMouseDown = useCallback(
    (e: MouseEvent<SVGSVGElement>) => {
      if (e.button !== 0) return
      const target = e.target as Element
      if (target.closest('[data-node]')) return
      const rect = containerRef.current?.getBoundingClientRect()
      dragRef.current = {
        startX: e.clientX,
        startY: e.clientY,
        vbX: viewBox.x,
        vbY: viewBox.y,
        w: viewBox.w,
        h: viewBox.h,
      }
      setIsDragging(true)
      setSelected(null)
      setContextMenu(null)
      void rect
    },
    [viewBox.x, viewBox.y, viewBox.w, viewBox.h],
  )

  const onSvgMouseMove = useCallback((e: MouseEvent<SVGSVGElement>) => {
    const drag = dragRef.current
    if (!drag) return
    const container = containerRef.current
    if (!container) return
    const rect = container.getBoundingClientRect()
    const scaleX = drag.w / rect.width
    const scaleY = drag.h / rect.height
    const dx = (e.clientX - drag.startX) * scaleX
    const dy = (e.clientY - drag.startY) * scaleY
    setViewBox({ x: drag.vbX - dx, y: drag.vbY - dy, w: drag.w, h: drag.h })
  }, [])

  const onSvgMouseUp = useCallback(() => {
    dragRef.current = null
    setIsDragging(false)
  }, [])

  const onWheel = useCallback(
    (e: WheelEvent<HTMLDivElement>) => {
      e.preventDefault()
      const container = containerRef.current
      if (!container) return
      const rect = container.getBoundingClientRect()
      const px = (e.clientX - rect.left) / rect.width
      const py = (e.clientY - rect.top) / rect.height
      const factor = e.deltaY > 0 ? 1.15 : 1 / 1.15
      const newW = Math.min(Math.max(viewBox.w * factor, baseW * MIN_SCALE), baseW * MAX_SCALE)
      const newH = newW * (viewBox.h / viewBox.w)
      const worldX = viewBox.x + px * viewBox.w
      const worldY = viewBox.y + py * viewBox.h
      setViewBox({ x: worldX - px * newW, y: worldY - py * newH, w: newW, h: newH })
    },
    [viewBox, baseW],
  )

  const resetView = useCallback(() => {
    setViewBox({ x: 0, y: 0, w: baseW, h: baseH })
  }, [baseW, baseH])

  const onNodeContextMenu = useCallback(
    (e: MouseEvent<SVGGElement>, step: number) => {
      e.preventDefault()
      e.stopPropagation()
      const container = containerRef.current
      if (!container) return
      const rect = container.getBoundingClientRect()
      setContextMenu({ x: e.clientX - rect.left, y: e.clientY - rect.top, step })
      setSelected({ kind: 'plan', step })
    },
    [],
  )

  const onPlanClick = useCallback((e: MouseEvent<SVGGElement>, step: number) => {
    e.stopPropagation()
    setSelected((prev) => (prev?.kind === 'plan' && prev.step === step ? null : { kind: 'plan', step }))
    setContextMenu(null)
  }, [])

  const onToolClick = useCallback((e: MouseEvent, callId: string) => {
    e.stopPropagation()
    setSelected((prev) => (prev?.kind === 'tool' && prev.callId === callId ? null : { kind: 'tool', callId }))
    setContextMenu(null)
  }, [])

  const onArtifactClick = useCallback(
    (e: MouseEvent<SVGTextElement>, path: string) => {
      e.stopPropagation()
      onPreviewArtifact(path)
    },
    [onPreviewArtifact],
  )

  // ── 详情条数据 ──
  const detailPlan = selected?.kind === 'plan' ? layout!.planNodes.find((n) => n.step === selected.step) : undefined
  const detailTool = selected?.kind === 'tool' ? layout!.toolNodes.find((n) => n.tool.callId === selected.callId) : undefined
  const detailArts = detailPlan ? artifactsByStep.get(detailPlan.step) ?? [] : []

  // ── 空状态 ──
  if (!hasAny) {
    return (
      <div className="agent-dag">
        <div className="agent-dag__empty">
          发送一次任务后，这里会展示本轮执行 DAG：
          <br />
          规划步骤（节点）+ 每步内部实际调用的工具（子节点），拖拽平移 · 滚轮缩放 · 点击节点看详情。
        </div>
      </div>
    )
  }

  // ── SIMPLE_CHAT 单点任务卡 ──
  if (!isComposite) {
    return (
      <div className="agent-dag agent-dag--simple">
        <div className="agent-dag__simple-head">
          <Wrench size={13} />
          <span>单点任务（无规划 DAG）</span>
        </div>
        <div className="agent-dag__simple-flow">
          {simpleTools.map((t) => {
            const color = TOOL_COLOR[t.status] ?? TOOL_COLOR.running
            return (
              <div key={t.callId} className="agent-dag__simple-item" onClick={(e) => onToolClick(e, t.callId)} style={{ borderLeftColor: color }}>
                <span className="agent-dag__simple-dot" style={{ background: color }} />
                <span className="agent-dag__simple-name">{toolDisplay(t)}</span>
                {t.op && <span className="agent-dag__simple-op">{t.op}</span>}
                {t.path && <span className="agent-dag__simple-path" title={t.path}>→ {truncate(t.path, 28)}</span>}
              </div>
            )
          })}
        </div>
        {detailTool && (
          <div className="agent-dag__detail">
            <ToolDetail tool={detailTool.tool} onPreviewArtifact={onPreviewArtifact} onClose={() => setSelected(null)} />
          </div>
        )}
      </div>
    )
  }

  return (
    <div
      className="agent-dag agent-dag--interactive"
      ref={containerRef}
      onWheel={onWheel}
      onMouseDown={() => setContextMenu(null)}
    >
      {planBranch && (
        <div className="agent-dag__branch-banner">
          <div className="agent-dag__branch-head">
            <GitBranch size={14} />
            <span>分支重规划（从步骤 {planBranch.fromStep + 1} 起）</span>
            <span className="agent-dag__branch-goal">{planBranch.goalSummary}</span>
          </div>
          <div className="agent-dag__branch-body">
            <div className="agent-dag__branch-col">
              <div className="agent-dag__branch-label">原方案（{planBranch.originalTail.length} 步）</div>
              {planBranch.originalTail.map((t: BranchStep) => (
                <div key={t.step} className="agent-dag__branch-item agent-dag__branch-item--old">
                  <span className="agent-dag__branch-step">{t.step}</span>
                  <span>{truncate(t.title, 16)}</span>
                </div>
              ))}
            </div>
            <div className="agent-dag__branch-col">
              <div className="agent-dag__branch-label">新分支（{planBranch.branchTasks.length} 步）</div>
              {planBranch.branchTasks.map((t: BranchStep) => (
                <div key={t.step} className="agent-dag__branch-item agent-dag__branch-item--new">
                  <span className="agent-dag__branch-step">{t.step}</span>
                  <span>{truncate(t.title, 16)}</span>
                </div>
              ))}
            </div>
          </div>
          <div className="agent-dag__branch-actions">
            <button type="button" className="agent-dag__branch-btn agent-dag__branch-btn--apply" onClick={onApplyBranch}>
              应用分支
            </button>
            <button type="button" className="agent-dag__branch-btn agent-dag__branch-btn--dismiss" onClick={onDismissBranch}>
              放弃
            </button>
          </div>
        </div>
      )}

      <div className="agent-dag__toolbar">
        <button type="button" title="重置视图" onClick={resetView}>
          <Maximize size={14} />
        </button>
      </div>

      <svg
        className={`agent-dag__svg${isDragging ? ' is-dragging' : ''}`}
        width="100%"
        height="100%"
        viewBox={`${viewBox.x} ${viewBox.y} ${viewBox.w} ${viewBox.h}`}
        preserveAspectRatio="xMidYMid meet"
        onMouseDown={onSvgMouseDown}
        onMouseMove={onSvgMouseMove}
        onMouseUp={onSvgMouseUp}
        onMouseLeave={onSvgMouseUp}
      >
        <defs>
          <marker id="dag-arrow" markerWidth="11" markerHeight="11" refX="8" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-border, #c4c9d4)" />
          </marker>
        </defs>

        {/* 连边：依赖/父子/链 */}
        {layout!.edges.map((e, i) => {
          const midY = (e.sy + e.ty) / 2
          const d = `M ${e.sx},${e.sy} C ${e.sx},${midY} ${e.tx},${midY} ${e.tx},${e.ty}`
          const stroke = e.kind === 'dep' ? 'var(--color-border, #c4c9d4)' : 'var(--color-muted, #cbd5e1)'
          return <path key={i} d={d} fill="none" stroke={stroke} strokeWidth={e.kind === 'dep' ? 1.5 : 1} markerEnd="url(#dag-arrow)" />
        })}

        {/* 工具子节点 */}
        {layout!.toolNodes.map((n) => {
          const color = TOOL_COLOR[n.tool.status] ?? TOOL_COLOR.running
          const isSel = selected?.kind === 'tool' && selected.callId === n.tool.callId
          const running = n.tool.status === 'running'
          return (
            <g
              key={n.tool.callId}
              data-node
              transform={`translate(${n.x},${n.y})`}
              onClick={(e) => onToolClick(e, n.tool.callId)}
              style={{ cursor: 'pointer' }}
              className={running ? 'agent-dag__node--running' : ''}
            >
              <title>{n.tool.toolName}</title>
              <rect width={SUB_W} height={SUB_H} rx={7} ry={7} fill={isSel ? 'var(--color-background-subtle, #f0f4ff)' : 'var(--color-background, #fff)'} stroke={color} strokeWidth={isSel ? 2 : 1} />
              <circle cx={13} cy={SUB_H / 2} r={6} fill={color} />
              {running ? (
                <Loader2 x={9} y={SUB_H / 2 - 4} size={8} className="agent-dag__spin" color="#fff" />
              ) : n.tool.status === 'success' ? (
                <CheckCircle2 x={9} y={SUB_H / 2 - 4} size={8} color="#fff" />
              ) : n.tool.status === 'failed' ? (
                <XCircle x={9} y={SUB_H / 2 - 4} size={8} color="#fff" />
              ) : null}
              <text x={26} y={SUB_H / 2 + 1} fontSize={11} fontWeight={500} fill="var(--color-foreground, #222)">
                {truncate(toolDisplay(n.tool), 9)}
              </text>
              <text x={SUB_W - 8} y={SUB_H / 2 + 1} textAnchor="end" fontSize={9.5} fill={color}>
                {TOOL_LABEL[n.tool.status] ?? ''}
              </text>
            </g>
          )
        })}

        {/* 规划步骤节点（顶层） */}
        {layout!.planNodes.map((n) => {
          const color = PLAN_COLOR[n.node.status] ?? PLAN_COLOR.pending
          const isSel = selected?.kind === 'plan' && selected.step === n.step
          const running = n.node.status === 'running'
          const arts = artifactsByStep.get(n.step) ?? []
          return (
            <g
              key={n.step}
              data-node
              transform={`translate(${n.x},${n.y})`}
              onClick={(e) => onPlanClick(e, n.step)}
              onContextMenu={(e) => onNodeContextMenu(e, n.step)}
              style={{ cursor: 'pointer' }}
              className={running ? 'agent-dag__node--running' : ''}
            >
              <rect
                width={NODE_W}
                height={NODE_H}
                rx={10}
                ry={10}
                fill={isSel ? 'var(--color-background-subtle, #f0f4ff)' : 'var(--color-background, #fff)'}
                stroke={color}
                strokeWidth={isSel ? 2.5 : 1.5}
              />
              <circle cx={16} cy={16} r={10} fill={color} />
              {running ? (
                <Loader2 x={12} y={12} size={8} className="agent-dag__spin" color="#fff" />
              ) : (
                <text x={16} y={20} textAnchor="middle" fontSize={11} fontWeight={600} fill="#fff">
                  {n.node.step}
                </text>
              )}
              <text x={34} y={20} fontSize={12.5} fontWeight={600} fill="var(--color-foreground, #222)">
                {truncate(n.node.title, 11)}
              </text>
              {/* 工具子节点数量角标 */}
              {n.subCount > 0 && (
                <text x={10} y={42} fontSize={10} fill="var(--color-muted, #999)">
                  {n.subCount} 个工具动作
                </text>
              )}
              {arts.length > 0 && (
                <text
                  x={10}
                  y={54}
                  fontSize={11}
                  fill="var(--color-primary, #1677ff)"
                  style={{ cursor: 'pointer' }}
                  onClick={(e) => onArtifactClick(e, arts[0].path)}
                  data-artifact
                >
                  产物 {arts.length} →
                </text>
              )}
              <text x={NODE_W - 10} y={54} textAnchor="end" fontSize={11} fontWeight={600} fill={color}>
                {PLAN_LABEL[n.node.status] ?? ''}
              </text>
            </g>
          )
        })}
      </svg>

      {/* 选中节点详情条 */}
      {(detailPlan || detailTool) && (
        <div className="agent-dag__detail">
          <button type="button" className="agent-dag__detail-close" onClick={() => setSelected(null)}>
            <X size={13} />
          </button>
          {detailPlan && (
            <div className="agent-dag__detail-body">
              <div className="agent-dag__detail-title">
                步骤 {detailPlan.node.step} · {detailPlan.node.title}
                <span className="agent-dag__detail-status" style={{ color: PLAN_COLOR[detailPlan.node.status] }}>
                  {PLAN_LABEL[detailPlan.node.status]}
                </span>
              </div>
              {detailPlan.node.summary && <div className="agent-dag__detail-sum">{detailPlan.node.summary}</div>}
              {detailArts.length > 0 && (
                <div className="agent-dag__detail-arts">
                  {detailArts.map((a) => (
                    <button key={a.artifactId} type="button" className="agent-dag__detail-art" onClick={() => onPreviewArtifact(a.path)} title={a.path}>
                      <FileText size={13} />
                      <span>{truncate(a.description || a.path, 22)}</span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}
          {detailTool && <ToolDetail tool={detailTool.tool} onPreviewArtifact={onPreviewArtifact} onClose={() => setSelected(null)} />}
        </div>
      )}

      {/* 右键菜单 */}
      {contextMenu && (
        <div className="agent-dag__context-menu" style={{ left: contextMenu.x, top: contextMenu.y }} onMouseDown={(e) => e.stopPropagation()}>
          <button
            type="button"
            onClick={() => {
              onBranchFromStep(contextMenu.step)
              setContextMenu(null)
            }}
          >
            <GitBranch size={13} />
            从步骤 {contextMenu.step} 起分支重规划
          </button>
        </div>
      )}
    </div>
  )
}

// ── 工具节点详情（复用渲染） ──
function ToolDetail({
  tool,
  onPreviewArtifact,
  onClose,
}: {
  tool: ToolStep
  onPreviewArtifact: (path: string) => void
  onClose: () => void
}) {
  void onClose
  const color = TOOL_COLOR[tool.status] ?? TOOL_COLOR.running
  return (
    <div className="agent-dag__detail-body">
      <div className="agent-dag__detail-title">
        {tool.toolLabel}
        <span className="agent-dag__detail-status" style={{ color }}>
          {TOOL_LABEL[tool.status]}
        </span>
      </div>
      {tool.op && (
        <div className="agent-dag__detail-row">
          <span className="agent-dag__detail-k">操作</span>
          <span>{tool.op}</span>
        </div>
      )}
      {tool.path && (
        <div className="agent-dag__detail-row">
          <span className="agent-dag__detail-k">路径</span>
          <span className="agent-dag__detail-path" title={tool.path}>{tool.path}</span>
        </div>
      )}
      {(typeof tool.linesAdded === 'number' || typeof tool.linesRemoved === 'number') && (
        <div className="agent-dag__detail-row">
          <span className="agent-dag__detail-k">变更</span>
          <span className="agent-dag__detail-diff">
            {typeof tool.linesAdded === 'number' && <span className="agent-dag__diff-add">+{tool.linesAdded}</span>}
            {typeof tool.linesRemoved === 'number' && <span className="agent-dag__diff-del">-{tool.linesRemoved}</span>}
          </span>
        </div>
      )}
      {tool.result && (
        <div className="agent-dag__detail-row">
          <span className="agent-dag__detail-k">结果</span>
          <span className="agent-dag__detail-result">{truncate(tool.result.replace(/\s+/g, ' '), 120)}</span>
        </div>
      )}
      {tool.path && (
        <button type="button" className="agent-dag__detail-preview" onClick={() => onPreviewArtifact(tool.path!)}>
          <FileText size={12} /> 预览产物
        </button>
      )}
    </div>
  )
}
