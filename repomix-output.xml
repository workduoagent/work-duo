/* ============================================================
 * pages/mcp/detail — MCP 服务详情页
 * 仅使用设计令牌 var(--color-*)，不写 hex / px 字面量。
 * 工具卡片 / 配置块等样式复用 index.scss（已在此页 import）。
 * 背景与列表页一致：白底（var(--color-background)）。
 * ============================================================ */

.mcphub-detail-page {
  height: 100%;
  padding: 20px 24px;
  box-sizing: border-box;
  overflow-y: auto;
  /* 与列表页一致：页面白底，卡片/侧栏浅灰 */
  background: var(--color-background);
}

.mcphub-detail-page__loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.mcphub-detail-page__nav {
  margin-bottom: 16px;
}

.mcphub-detail-page__header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 16px;
}

.mcphub-detail-page__header-logo {
  width: 56px;
  height: 56px;
  flex: 0 0 56px;
  border-radius: 14px;
  background: var(--color-brand-50);
  color: var(--color-brand-600);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mcphub-detail-page__title-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mcphub-detail-page__title {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
  color: var(--color-foreground-intense);
}

.mcphub-detail-page__desc {
  margin: 4px 0 0;
  font-size: 13px;
  color: var(--color-foreground-muted);
}

.mcphub-detail-page__section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mcphub-detail-page__url {
  font-family: var(--font-mono, monospace);
  font-size: 12px;
  word-break: break-all;
}

.mcphub-detail-page__configs {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mcphub-detail__config {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.mcphub-detail__config-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--color-foreground-muted);
}

/* ---------------- 工具 Tab ---------------- */
.mcphub-tools-content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mcphub-detail__tools-bar {
  display: flex;
  justify-content: flex-end;
}

/* 工具卡片网格（仿列表卡片：auto-fill 自适应列宽） */
.mcphub-tools {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 14px;
  align-content: start;
  padding: 4px 4px 16px 4px;
}

.mcphub-tool-card {
  position: relative;
  height: 100%;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

/* flex 列布局下沉到 .ant-card-body（与列表卡片同范式） */
.app-card.mcphub-tool-card .ant-card-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
  height: 100%;
  padding: 16px;
}

.mcphub-tool-card:hover {
  transform: translateY(-3px);
  border-color: var(--color-brand-300, var(--color-brand-600));
  box-shadow: var(--shadow-md);
}

.mcphub-tool-card--disabled {
  opacity: 0.62;
}

/* 头部：状态点 + 标题 + 标识 */
.mcphub-tool-card__head {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  padding-right: 4px;
}

.mcphub-tool-status-dot {
  flex: 0 0 auto;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--color-foreground-muted);
}

.mcphub-tool-status-dot.active {
  background-color: var(--color-brand-600);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand-600) 22%, transparent);
}

.mcphub-tool-card__title {
  margin: 0;
  min-width: 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-foreground-intense);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mcphub-tool-card__code {
  flex: 0 0 auto;
  max-width: 50%;
  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
  font-size: 11px;
  color: var(--color-foreground-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 描述（过多时缩略展示） */
.mcphub-tool-card__desc {
  margin: 0;
  font-size: 12px;
  line-height: 1.6;
  color: var(--color-foreground-muted);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部操作栏：图标按钮靠左 + Switch 靠右（与列表卡片一致） */
.mcphub-tool-card__footer {
  display: flex;
  align-items: center;
  gap: 6px;
  padding-top: 12px;
  border-top: 1px solid var(--color-border);
  margin-top: auto;
}

.mcphub-tool-card__footer .ant-switch {
  margin-left: auto;
}

.mcphub-tool-card__del:hover {
  color: var(--color-danger) !important;
}

.mcphub-tools-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
}

