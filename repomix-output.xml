<file path="src/pages/agent-studio/wizard.scss">
/* 智能体新建 / 编辑向导（4 步）
   整页布局：顶部步骤条固定、内容区内部滚动、底部操作栏固定。 */
.agent-wizard {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 20px 28px 0;

  &--loading {
    align-items: center;
    justify-content: center;
    color: var(--color-foreground-muted);
  }

  /* ---------- 头部 ---------- */
  &__head {
    flex-shrink: 0;
  }

  &__head-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  &__head-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  &__head-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  &__title {
    margin: 0;
    font-size: 20px;
    font-weight: 650;
    color: var(--color-foreground-intense);
  }

  &__identifier-tag {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
    font-size: 11.5px;
    padding: 2px 8px;
    border-radius: 999px;
    background-color: var(--color-background-muted);
    color: var(--color-foreground-muted);
  }

  /* ---------- 步骤条 ---------- */
  &__steps {
    display: flex;
    align-items: stretch;
    gap: 8px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }

  &__step {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background-color: var(--color-background-subtle);
    color: var(--color-foreground-muted);
    cursor: default;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;

    &.is-done {
      cursor: pointer;
      color: var(--color-brand-600);

      &:hover {
        background-color: var(--color-background-muted);
      }
    }

    &.is-current {
      border-color: var(--color-brand-600);
      background-color: var(--color-background);
      color: var(--color-foreground-intense);
      box-shadow: var(--shadow-sm);
    }
  }

  &__step-index {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    background-color: var(--color-background-muted);
    color: var(--color-foreground-muted);
  }

  &__step.is-current &__step-index {
    background-color: var(--color-brand-600);
    color: var(--color-foreground-inverse);
  }

  &__step.is-done &__step-index {
    background-color: var(--color-brand-50);
    color: var(--color-brand-600);
  }

  &__step-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;

    strong {
      font-size: 13px;
      font-weight: 600;
      line-height: 18px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    em {
      font-style: normal;
      font-size: 11px;
      line-height: 16px;
      opacity: 0.75;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* ---------- 内容区（水平垂直居中，限宽 80%） ---------- */
  &__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 24px 4px 24px;
    display: flex;
    flex-direction: column;
    align-items: center; /* 水平居中 */
    justify-content: safe center; /* 垂直居中；内容超高时安全回退到顶部可滚动 */

    > * {
      width: 100%;
      max-width: 80%;
    }
  }

  &__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
  }

  &__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 16px 18px;
  }

  &__span-2 {
    grid-column: 1 / -1;
  }

  &__identifier {
    display: flex;
    align-items: center;
    gap: 8px;

    .ant-input-affix-wrapper,
    input {
      flex: 1 1 auto;
    }
  }

  &__row {
    display: flex;
    flex-direction: column;
  }

  &__hint {
    font-style: normal;
    font-size: 11.5px;
    line-height: 16px;
    color: var(--color-foreground-muted);
  }

  /* ---------- 步骤1：头像（顶部，点击上传） ---------- */
  &__logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  &__logo-preview {
    position: relative;
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-background-muted);
  }

  &__logo-upload {
    cursor: pointer;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;

    &:hover {
      border-color: var(--color-brand-600);
      box-shadow: 0 0 0 3px var(--color-brand-50);
    }

    &:focus-visible {
      outline: 2px solid var(--color-brand-600);
      outline-offset: 2px;
    }
  }

  &__logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  &__logo-empty {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--color-foreground-muted);
  }

  &__logo-tip {
    font-size: 11px;
    line-height: 1;
  }

  &__logo-clear {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-danger);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.18s ease;

    &:hover {
      filter: brightness(0.92);
    }
  }

  &__logo-preview:hover &__logo-clear {
    opacity: 1;
  }

  /* ---------- 步骤1：开关组 ---------- */
  &__switches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
  }

  &__switch-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background-color: var(--color-background-subtle);
    cursor: pointer;
    max-width: 480px;

    > span {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 13px;
      line-height: 18px;
      color: var(--color-foreground);
    }
  }

  /* ---------- 步骤2：模型槽位 ---------- */
  &__slots {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    align-items: stretch;

    @media (max-width: 720px) {
      grid-template-columns: 1fr;
    }
  }

  &__slot {
    &.app-card {
      height: 100%;
      display: flex;
      flex-direction: column;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;

      &:hover {
        transform: translateY(-2px);
        border-color: var(--color-brand-300, var(--color-brand-600));
        box-shadow: var(--shadow-md);
      }
    }

    &.app-card .ant-card-body {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 20px;
    }
  }

  &__slot-head {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  &__slot-icon {
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand-50);
    color: var(--color-brand-600);

    svg {
      width: 22px;
      height: 22px;
    }
  }

  &__slot-titles {
    min-width: 0;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  &__slot-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 650;
    color: var(--color-foreground-intense);
  }

  &__required {
    padding: 0 6px;
    border-radius: 999px;
    font-size: 11px;
    line-height: 17px;
    background-color: var(--color-brand-50);
    color: var(--color-brand-600);
    flex: none;
  }

  &__slot-desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }

  &__param-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--color-border);
    font-size: 12px;
    color: var(--color-foreground-muted);
    flex-shrink: 0;
  }

  &__param-grid {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 14px 18px;
    align-content: start;
  }

  /* ---------- 步骤3/4：三栏挑选器 ---------- */
  &__picker {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 260px;
    gap: 14px;
    align-items: start;
    flex: 1 1 auto;
    min-height: 0;

    @media (max-width: 1100px) {
      grid-template-columns: 200px minmax(0, 1fr);
    }

    @media (max-width: 720px) {
      grid-template-columns: 1fr;
    }
  }

  &__picker--two {
    grid-template-columns: 1fr 260px;

    @media (max-width: 1100px) {
      grid-template-columns: 1fr;
    }
  }

  &__picker-aside {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px;
    border-radius: var(--radius-card);
    background-color: var(--color-background-subtle);
    border: 1px solid var(--color-border);
    max-height: 100%;
    min-height: 0;
  }

  &__picker-aside--right {
    @media (max-width: 1100px) {
      grid-column: 1 / -1;
    }
  }

  &__picker-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 4px 8px 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  &__picker-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow-y: auto;
    min-height: 0;
  }

  &__picker-item {
    box-sizing: border-box;
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: var(--color-foreground-muted);
    font-size: 13px;
    line-height: 18px;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease;

    &:hover {
      background-color: var(--color-background-muted);
      color: var(--color-foreground);
    }

    &.is-active {
      background-color: var(--color-background);
      color: var(--color-brand-600);
      font-weight: 600;
      box-shadow: var(--shadow-sm);
    }
  }

  &__picker-icon {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
  }

  &__picker-label {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  &__picker-badge {
    flex: 0 0 auto;
    min-width: 18px;
    padding: 0 6px;
    border-radius: 999px;
    background-color: var(--color-brand-600);
    color: var(--color-foreground-inverse);
    font-size: 11px;
    line-height: 18px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  &__picker-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  &__picker-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background-color: var(--color-background-subtle);
  }

  &__picker-head-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-foreground-intense);
  }

  &__picker-head-desc {
    margin-top: 2px;
    font-size: 12px;
    color: var(--color-foreground-muted);
  }

  /* ---------- 工具列表 ---------- */
  &__tool-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  &__tool {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background-color: var(--color-background-subtle);
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease;

    &:hover {
      border-color: var(--color-brand-600);
    }

    &.is-checked {
      border-color: var(--color-brand-600);
      background-color: var(--color-brand-50);
    }
  }

  &__tool-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  &__tool-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-foreground-intense);
  }

  &__tool-code {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-foreground-muted);
  }

  &__tool-desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-foreground-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------- 已选汇总 ---------- */
  &__selected-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px 0;

    & + & {
      border-top: 1px dashed var(--color-border);
    }
  }

  &__selected-group-title {
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-foreground-muted);
  }

  &__selected-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 8px;
    font-size: 12.5px;
    color: var(--color-foreground);

    &:hover {
      background-color: var(--color-background-muted);
    }
  }

  &__selected-check {
    flex: 0 0 auto;
    color: var(--color-brand-600);
  }

  &__selected-label {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  &__selected-del {
    flex: 0 0 auto;
    border: none;
    padding: 2px;
    border-radius: 6px;
    background: transparent;
    color: var(--color-foreground-muted);
    cursor: pointer;
    display: inline-flex;

    &:hover {
      color: var(--color-danger);
      background-color: var(--color-background-muted);
    }
  }

  /* ---------- 技能卡片 ---------- */
  &__skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 10px;
  }

  &__skill {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background-color: var(--color-background-subtle);
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease;

    &:hover {
      border-color: var(--color-brand-600);
    }

    &.is-checked {
      border-color: var(--color-brand-600);
      background-color: var(--color-brand-50);
    }
  }

  &__skill-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  &__skill-name {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-foreground-intense);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  &__skill-tag {
    flex: 0 0 auto;
    padding: 0 6px;
    border-radius: 999px;
    font-size: 11px;
    line-height: 17px;
    background-color: var(--color-background-muted);
    color: var(--color-foreground-muted);
  }

  &__skill-identifier {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
    font-size: 11px;
    color: var(--color-foreground-muted);
  }

  &__skill-desc {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-foreground-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------- 空态 / 加载 ---------- */
  &__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 72px 24px;
    text-align: center;
    color: var(--color-foreground-muted);

    p {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
      color: var(--color-foreground);
    }

    span {
      font-size: 12.5px;
      max-width: 420px;
      line-height: 1.6;
    }

    &--inline {
      padding: 36px 24px;
    }
  }

  &__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 72px 0;
  }

  &__empty-hint {
    padding: 18px 8px;
    font-size: 12.5px;
    color: var(--color-foreground-muted);
  }

  /* ---------- 字段错误提示 ---------- */
  &__error {
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-danger);
  }

  /* ---------- 边缘步骤切换箭头（轮播式） ---------- */
  &__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
    box-shadow: var(--shadow-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease, opacity 0.18s ease;

    &:hover:not(:disabled) {
      border-color: var(--color-brand-600);
      color: var(--color-brand-600);
    }

    &:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    &--prev {
      left: 8px;
    }

    &--next {
      right: 8px;
    }
  }

  @media (max-width: 720px) {
    &__body {
      padding-left: 52px;
      padding-right: 52px;
    }
  }
}
</file>

<file path="src/pages/knowledge/index.scss">
/* 知识库首页 */
.kb {
  padding: 24px 28px 32px;
  /* 全屏/最大化窗口下让内容占满可用宽度，避免右侧大片留白；
     卡片网格使用 auto-fill minmax(260px,1fr)，宽屏自动排列更多列。 */
  width: 100%;
  box-sizing: border-box;
  /* 满高布局：页面整体不出现 Y 轴滚动条；右侧主区内部滚动，左侧栏限高 50% 且内容溢出时自身滚动，分页器固定底部。 */
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box; /* 关键：抵消纵向 padding 对 100% 高度的撑破（content-box 下 padding 会使容器超出父级触发页面滚动条） */

  &__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  &__title {
    margin: 0;
    font-size: 22px;
    font-weight: 650;
    color: var(--color-foreground-intense);
  }

  &__lead {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--color-foreground-muted);
  }

  &__loading,
  &__empty {
    padding: 64px 0;
    text-align: center;
    color: var(--color-foreground-muted);
  }

  /* 卡片网格：对齐 MCP .mcphub-grid —— align-content:start 让卡片靠上排布、底部留白；内边距与 MCP 一致 */
  &__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
    align-content: start;
    padding: 4px 4px 16px 4px;
  }

  &__card {
    height: 100%; /* 撑满网格行高，便于同行卡片操作栏对齐（对齐 MCP） */
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    cursor: pointer;

    &:hover {
      transform: translateY(-3px);
      border-color: var(--color-brand-300, var(--color-brand-600));
      box-shadow: var(--shadow-md);
    }

    /* Card 封装把 className 挂在 antd Card 根节点（同时带 .app-card），
       各区块渲染在内部 .ant-card-body，故 flex 列布局必须下沉到 body 层。
       特异性 (0,3,0) 高于 antd 的 .ant-card .ant-card-body (0,2,0) */
    &.app-card .ant-card-body {
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: 100%;
      padding: 16px;
    }

    /* 头部：Logo + 标题组（对齐 MCP 的 head） */
    &-head {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    &-titles {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    &-title {
      margin: 0;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-foreground-intense);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &-del {
      color: var(--color-foreground-muted);

      &:hover {
        color: var(--color-danger) !important;
      }
    }

    &-desc {
      margin: 0;
      font-size: 12px;
      line-height: 1.6;
      color: var(--color-foreground-muted);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    &-meta {
      display: flex;
      gap: 14px;
      font-size: 12px;
      color: var(--color-foreground-muted);
    }

    &-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* 操作栏：查看 / 编辑 / 删除 以 icon 形式沉到卡片最底部（对齐 MCP actions） */
    &-actions {
      display: flex;
      align-items: center;
      gap: 6px;
      padding-top: 12px;
      border-top: 1px solid var(--color-border);
      margin-top: auto;
    }

    &-time {
      margin-left: auto; /* 更新时间靠右，与 MCP 操作栏右侧元素对齐 */
      font-size: 12px;
      color: var(--color-foreground-muted);
    }

    &-avatar {
      width: 36px;
      height: 36px;
      flex: none;
      border-radius: 9px;
      background: var(--color-brand-50);
      color: var(--color-brand-600);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    &-logo {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &-identifier {
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
      font-size: 11.5px;
      color: var(--color-foreground-muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    &-chip {
      padding: 1px 9px;
      border-radius: 999px;
      font-size: 11px;
      line-height: 18px;
      background-color: var(--color-background-muted);
      color: var(--color-foreground);
    }

    &-chip--muted {
      background-color: transparent;
      border: 1px solid var(--color-border);
      color: var(--color-foreground-muted);
    }
  }

  &__layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 20px;
    align-items: stretch;
    min-height: 0;
    flex: 1;
  }

  /* 左侧场景侧栏：样式对齐 MCP 模块（浅灰底 + 细边框 + 轻阴影 + 内部滚动） */
  &__sidebar {
    align-self: start; /* 不随布局拉伸，高度由内容决定 */
    min-height: 50%; /* 限高约 50%，超出则自身出现滚动条 */
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px;
    border-radius: var(--radius-card);
    background-color: var(--color-background-subtle);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    overflow-y: auto;
    overflow-x: hidden; /* 防止内部项 hover 位移触发横向滚动条 */
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  &__sidebar-title {
    padding: 6px 10px 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 6px;
  }

  &__cat-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
    overflow-x: hidden; /* 防止 hover 的 translateX(2px) 触发横向滚动条 */
  }

  /* 场景分类项：对齐 MCP 的 cat-item（hover 平移 + 选中态左侧指示条） */
  &__cat-item {
    box-sizing: border-box; /* 防止 width:100% + padding 在 content-box 下撑破容器触发横向滚动条 */
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: none;
    border-radius: 10px;
    background-color: transparent;
    color: var(--color-foreground-muted);
    font-size: 0.875rem;
    line-height: 20px;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.12s ease;

    &:hover {
      color: var(--color-foreground);
      background-color: var(--color-background-muted);
      transform: translateX(2px);
    }

    &.is-active {
      color: var(--color-brand-600);
      background-color: var(--color-background);
      font-weight: 600;
      box-shadow: var(--shadow-sm);
    }
  }

  &__cat-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    border-radius: 999px;
    background-color: var(--color-brand-600);
    transform: translateY(-50%);
    transition: height 0.22s ease;
  }

  &__cat-item.is-active::before {
    height: 60%;
  }

  &__cat-icon {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground-muted);
  }

  &__cat-item.is-active &__cat-icon {
    color: var(--color-brand-600);
  }

  &__cat-label {
    flex: 1 1 auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  &__cat-count {
    flex: 0 0 auto;
    min-width: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background-color: var(--color-brand-600);
    color: var(--color-foreground-inverse);
    font-size: 11px;
    line-height: 20px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  &__cat-item:not(.is-active) &__cat-count {
    background-color: var(--color-background-muted);
    color: var(--color-foreground-muted);
  }

  /* 右侧主区：对齐 MCP 的 .mcphub__main —— 滚动容器放在主区本身，卡片区 + 分页器一起在内部滚动 */
  &__main {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  /* 对齐 MCP .mcphub__spin：仅作 flex 撑满，不再单独滚动（滚动已由父级 .kb__main 接管） */
  &__spin {
    flex: 1 1 auto;
  }

  /* 分页器：对齐 MCP .mcphub__pagination（flex-shrink:0 固定在主区底部，不随卡片滚动） */
  &__pagination {
    flex-shrink: 0;
    display: flex;
    justify-content: flex-end;
    padding: 4px 4px 4px;
  }

  &__grid-empty {
    padding: 64px 0;
    text-align: center;
    color: var(--color-foreground-muted);
  }
}

/* 新建 / 编辑知识库表单弹窗 */
.kb-form {
  &__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 18px;

    /* 窄屏回退为单列，避免挤压 */
    @media (max-width: 520px) {
      grid-template-columns: 1fr;
    }
  }

  /* 跨整行的字段（如简介文本框） */
  &__field--full {
    grid-column: 1 / -1;
  }

  &__logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  &__logo-img {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--color-border-muted);
    cursor: pointer;
  }

  &__logo-empty {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground-muted);
    background: var(--color-surface-muted);
    border: 1px dashed var(--color-border-muted);
    cursor: pointer;
  }

  &__logo-del {
    color: var(--color-danger);
  }
}
