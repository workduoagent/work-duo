{
  "case_id": "agent-crud-001",
  "title": "Agent 增删改查全流程（逻辑 UI 意图桥）",
  "description": "通过 MCP 工具 agent.ui_create/update/get/delete，走与界面按钮同一的持久化入口，验证 CRUD 全链路与字段落库正确。",
  "tags": ["agent", "crud", "ui-bridge"],
  "setup": {
    "pre_clean": true
  },
  "steps": [
    {
      "step": 1,
      "tool": "agent.ui_create",
      "intent": "agent.ui_create",
      "payload": {
        "name": "自测智能体-CRUD",
        "identifier": "selftest-crud-agent",
        "scenario": "general",
        "description": "MVP1 自测样例",
        "systemPrompt": "你是一个用于自测的助手。",
        "mcpTools": [],
        "skillIds": [],
        "pluginIds": [],
        "kbIds": []
      },
      "oracle": {
        "assert_status": "ok",
        "then_call": "agent.ui_get",
        "then_payload": { "id_from_prev": "data.0.id" },
        "expect": {
          "exists": true,
          "name": "自测智能体-CRUD",
          "identifier": "selftest-crud-agent",
          "scenario": "general"
        },
        "llm_judge": "创建后查到的 Agent 名称/唯一标识/场景与入参一致，无异常日志。"
      }
    },
    {
      "step": 2,
      "tool": "agent.ui_update",
      "intent": "agent.ui_update",
      "payload_from_prev": { "id": "data.0.id", "name": "自测智能体-CRUD-改名", "identifier": "selftest-crud-agent" },
      "oracle": {
        "assert_status": "ok",
        "then_call": "agent.ui_get",
        "then_payload": { "id_from_prev": "data.0.id" },
        "expect": {
          "name": "自测智能体-CRUD-改名"
        },
        "llm_judge": "改名后查到的名称已更新为「自测智能体-CRUD-改名」。"
      }
    },
    {
      "step": 3,
      "tool": "agent.ui_delete",
      "intent": "agent.ui_delete",
      "payload_from_prev": { "id": "data.0.id" },
      "oracle": {
        "assert_status": "ok",
        "then_call": "agent.ui_get",
        "then_payload": { "id_from_prev": "data.0.id" },
        "expect": {
          "exists": false
        },
        "llm_judge": "删除后再次查询应返回 undefined，列表中也应当消失。"
      }
    }
  ],
  "scoring": {
    "dimensions": ["correctness", "data_consistency", "ui_parity", "robustness", "logs"],
    "pass_threshold": 0.8
  }
}
